# ════════════════════════════════════════════════════════
# .env.example  –  Copy this to .env and fill in values
# NEVER commit the real .env file to Git
# ════════════════════════════════════════════════════════

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated: your Render domain + localhost for local dev
ALLOWED_HOSTS=your-app-name.onrender.com,127.0.0.1,localhost
# Must start with https:// — same as ALLOWED_HOSTS but with scheme
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com

# Database (PostgreSQL on Neon / Render)
DATABASE_URL=postgresql://user:password@host/dbname

# Cashfree Payment Gateway
CASHFREE_APP_ID=your_cashfree_client_id_here
CASHFREE_SECRET_KEY=your_cashfree_client_secret_here
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
